# Copie este arquivo para .env e ajuste a senha
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=escola_notificacao
PORT=3000

# Gere uma chave aleatória com pelo menos 32 caracteres. Nunca use VITE_ para credenciais.
ADMIN_WHATSAPP_KEY=
# Ative somente após configurar e aprovar o modelo na Meta.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Informe uma versão suportada da Graph API no formato vNN.N.
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE=ocorrencia_registrada
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Endereço público do frontend conectado ao mesmo backend. Sem query string ou fragmento.
APP_PUBLIC_URL=https://escola-notificacao.pages.dev/
